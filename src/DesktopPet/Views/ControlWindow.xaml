<Window x:Class="DesktopPet.Views.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Pet — Panel Kontrol &amp; Tester"
        Height="780" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#1E1E2E"
        Foreground="#CDD6F4"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45475A"/>
                                <Setter Property="BorderBrush" Value="#89B4FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#585B70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#89B4FA"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#89B4FA"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14">
            <!-- Header & Status -->
            <Border Background="#181825" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Kawahime Desktop Pet" FontSize="16" FontWeight="Bold" Foreground="#89B4FA"/>
                    <TextBlock x:Name="TxtStatus" Text="Status: Idle (Frame 0/6)" Margin="0,4,0,0" Foreground="#A6ADC8" FontSize="12"/>
                    <TextBlock x:Name="TxtPriority" Text="Prioritas Aktif: Idle" Margin="0,2,0,0" Foreground="#F9E2AF" FontSize="11"/>
                </StackPanel>
            </Border>

            <!-- Resource Monitoring & Live Overhead (Tahap 3) -->
            <GroupBox Header="Resource Komputer &amp; Overhead (Tahap 3)">
                <StackPanel>
                    <!-- System CPU -->
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Beban CPU Sistem:" FontSize="11" Foreground="#A6ADC8"/>
                        <TextBlock x:Name="TxtLiveCpu" Grid.Column="1" Text="0.0%" FontSize="11" FontWeight="Bold" Foreground="#89B4FA"/>
                    </Grid>
                    <ProgressBar x:Name="PbCpu" Minimum="0" Maximum="100" Value="0" Margin="0,2,0,6"/>

                    <!-- System RAM -->
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Penggunaan RAM Sistem:" FontSize="11" Foreground="#A6ADC8"/>
                        <TextBlock x:Name="TxtLiveRam" Grid.Column="1" Text="0.0% (0.0 / 0.0 GB)" FontSize="11" FontWeight="Bold" Foreground="#FAB387"/>
                    </Grid>
                    <ProgressBar x:Name="PbRam" Minimum="0" Maximum="100" Value="0" Margin="0,2,0,6" Foreground="#FAB387"/>

                    <!-- App Overhead Footprint -->
                    <Border Background="#181825" CornerRadius="6" Padding="8,6" Margin="0,2,0,8">
                        <TextBlock x:Name="TxtAppFootprint" Text="DesktopPet Overhead: RAM 0.0 MB | CPU 0.0%" FontSize="11" Foreground="#A6E3A1"/>
                    </Border>

                    <!-- Threshold Sliders & Hysteresis -->
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Ambang CPU Tinggi:" FontSize="11" VerticalAlignment="Center"/>
                        <Slider x:Name="SliderCpuThreshold" Grid.Column="1" Minimum="40" Maximum="95" Value="80"
                                ValueChanged="SliderCpuThreshold_ValueChanged" Margin="8,0"/>
                        <TextBlock x:Name="TxtCpuThresholdVal" Grid.Column="2" Text="80%" FontSize="11" FontWeight="Bold"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Ambang RAM Tinggi:" FontSize="11" VerticalAlignment="Center"/>
                        <Slider x:Name="SliderRamThreshold" Grid.Column="1" Minimum="40" Maximum="95" Value="85"
                                ValueChanged="SliderRamThreshold_ValueChanged" Margin="8,0"/>
                        <TextBlock x:Name="TxtRamThresholdVal" Grid.Column="2" Text="85%" FontSize="11" FontWeight="Bold"/>
                    </Grid>

                    <!-- Resource Simulations -->
                    <TextBlock Text="Simulasi Beban Sistem:" FontSize="11" Foreground="#A6ADC8" Margin="0,6,0,2"/>
                    <WrapPanel Orientation="Horizontal">
                        <Button Content="🔥 Simulasikan CPU Tinggi (92%)" Click="BtnSimulateHighCpu_Click" Width="205"/>
                        <Button Content="⚡ Simulasikan RAM Penuh (88%)" Click="BtnSimulateHighRam_Click" Width="205"/>
                    </WrapPanel>
                    <Button Content="Normalkan Beban Sistem" Background="#45475A" Click="BtnNormalizeResource_Click" Margin="3,4,3,0"/>
                </StackPanel>
            </GroupBox>

            <!-- State Machine & Event Simulation -->
            <GroupBox Header="Simulasi Event &amp; Prioritas (Tahap 2)">
                <StackPanel>
                    <TextBlock Text="Uji respon hierarki prioritas state machine:" FontSize="11" Foreground="#A6ADC8" Margin="4,0,0,4"/>
                    <CheckBox x:Name="ChkSimError" Content="Simulasikan Error (Failed - Prioritas Tinggi)" Click="ChkSimError_Click"/>
                    <CheckBox x:Name="ChkSimWaiting" Content="Simulasikan Butuh Respons (Waiting)" Click="ChkSimWaiting_Click"/>
                    <CheckBox x:Name="ChkSimWork" Content="Simulasikan Kerja Komputer (Running)" Click="ChkSimWork_Click"/>
                    <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Kirim Notifikasi (Waving 1x)" Click="BtnSimNotification_Click" Width="205"/>
                        <Button Content="Tugas Selesai (Jumping 1x)" Click="BtnSimSuccess_Click" Width="205"/>
                    </WrapPanel>
                    <Button Content="Reset Semua Simulasi Event" Background="#45475A" Click="BtnResetSimulations_Click" Margin="3,6,3,0"/>
                </StackPanel>
            </GroupBox>

            <!-- Integrasi Aplikasi & IPC Named Pipe (Tahap 4) -->
            <GroupBox Header="Integrasi Aplikasi &amp; IPC Named Pipe (Tahap 4)">
                <StackPanel>
                    <TextBlock Text="Komunikasi antar-proses (IPC) Named Pipe untuk event build, test, error, dan notifikasi:" FontSize="11" Foreground="#A6ADC8" Margin="0,0,0,6" TextWrapping="Wrap"/>

                    <!-- IPC Toggle & Status -->
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="ChkIpcEnabled" Content="Server Named Pipe (\\.\pipe\DesktopPetIpc)" Click="ChkIpcEnabled_Click" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtIpcStatus" Grid.Column="1" Text="Aktif" FontSize="11" FontWeight="Bold" Foreground="#A6E3A1" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Event Type Selector -->
                    <Grid Margin="0,4,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tipe Event:" FontSize="11" Foreground="#A6ADC8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="CmbEventType" Grid.Column="1" Background="#313244" Foreground="#11111B" BorderBrush="#45475A">
                            <ComboBoxItem Content="start (Pekerjaan Dimulai - Running)" Tag="start"/>
                            <ComboBoxItem Content="success (Pekerjaan Selesai - Jumping)" IsSelected="True" Tag="success"/>
                            <ComboBoxItem Content="error (Proses Gagal - Failed)" Tag="error"/>
                            <ComboBoxItem Content="needs_action (Butuh Tindakan - Waiting)" Tag="needs_action"/>
                            <ComboBoxItem Content="notify (Notifikasi Info - Waving)" Tag="notify"/>
                            <ComboBoxItem Content="clear (Bersihkan Balon &amp; Reset)" Tag="clear"/>
                        </ComboBox>
                    </Grid>

                    <!-- Title & Message TextBoxes -->
                    <TextBlock Text="Judul Notifikasi:" FontSize="11" Foreground="#A6ADC8" Margin="0,4,0,1"/>
                    <TextBox x:Name="TxtIpcTitle" Text="Build Berhasil" Background="#181825" Foreground="#CDD6F4" BorderBrush="#45475A" Padding="6,3"/>

                    <TextBlock Text="Pesan Notifikasi / Balon:" FontSize="11" Foreground="#A6ADC8" Margin="0,4,0,1"/>
                    <TextBox x:Name="TxtIpcMessage" Text="Kompilasi proyek DesktopPet selesai dalam 1.2 detik." Background="#181825" Foreground="#CDD6F4" BorderBrush="#45475A" Padding="6,3"/>

                    <Grid Margin="0,4,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,3,0">
                            <TextBlock Text="Tombol Aksi (Opsional):" FontSize="11" Foreground="#A6ADC8" Margin="0,0,0,1"/>
                            <TextBox x:Name="TxtIpcActionLabel" Text="Lihat Hasil" Background="#181825" Foreground="#CDD6F4" BorderBrush="#45475A" Padding="6,3"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="3,0,0,0">
                            <TextBlock Text="Durasi Balon (detik, 0=tetap):" FontSize="11" Foreground="#A6ADC8" Margin="0,0,0,1"/>
                            <TextBox x:Name="TxtIpcTimeout" Text="5" Background="#181825" Foreground="#CDD6F4" BorderBrush="#45475A" Padding="6,3"/>
                        </StackPanel>
                    </Grid>

                    <Button x:Name="BtnSendIpcEvent" Content="🚀 Kirim Event IPC (Simulasi Client Pipe)" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" Margin="0,6,0,2" Click="BtnSendIpcEvent_Click"/>
                    <TextBlock x:Name="TxtIpcResult" Text="" FontSize="11" Foreground="#A6E3A1" Margin="0,2,0,6" TextWrapping="Wrap"/>

                    <!-- Process Watcher Section -->
                    <Border BorderBrush="#45475A" BorderThickness="0,1,0,0" Margin="0,4,0,4" Padding="0,6,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ChkProcessWatcher" Content="Pantau Proses Otomatis (Process Watcher)" Click="ChkProcessWatcher_Click" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtWatcherStatus" Grid.Column="1" Text="Aktif" FontSize="11" FontWeight="Bold" Foreground="#A6E3A1" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="Daftar proses target yang dipantau (start &amp; exit code):" FontSize="11" Foreground="#A6ADC8" Margin="0,2,0,4"/>
                            
                            <ListBox x:Name="LstWatchedProcesses" Height="75" Background="#181825" Foreground="#CDD6F4" BorderBrush="#45475A"/>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtNewProcessName" Text="cargo" Background="#181825" Foreground="#CDD6F4" BorderBrush="#45475A" Padding="6,3" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Tambah" Width="70" Click="BtnAddProcess_Click" Margin="4,0,2,0"/>
                                <Button Grid.Column="2" Content="Hapus" Width="70" Click="BtnRemoveProcess_Click" Margin="2,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </GroupBox>

            <!-- 9 Main Animations Manual Tester -->
            <GroupBox Header="9 Animasi Utama (Manual Test — Terkunci dari Gaze)">
                <StackPanel>
                    <TextBlock Text="Klik salah satu animasi di bawah untuk memutarnya terus-menerus:" FontSize="11" Foreground="#A6ADC8" Margin="4,0,0,4"/>
                    <WrapPanel Orientation="Horizontal" ItemWidth="205">
                        <Button Content="0. Idle (Diam Berdiri)" Click="BtnIdle_Click"/>
                        <Button Content="1. Berlari ke Kanan" Click="BtnRunRight_Click" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold"/>
                        <Button Content="2. Berlari ke Kiri" Click="BtnRunLeft_Click" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold"/>
                        <Button Content="3. Waving (Lambaikan Tangan)" Click="BtnWaving_Click"/>
                        <Button Content="4. Jumping (Melompat Ceria)" Click="BtnJumping_Click"/>
                        <Button Content="5. Failed (Sedih / Error)" Click="BtnFailed_Click"/>
                        <Button Content="6. Waiting (Bertanya / Menunggu)" Click="BtnWaiting_Click"/>
                        <Button Content="7. PC Task Running (Semangat)" Click="BtnRunWork_Click"/>
                        <Button Content="8. Review (Mengetik Aktif)" Click="BtnReview_Click"/>
                    </WrapPanel>
                    <Button Content="▶️ Kembali ke Mode Otomatis (State Machine)" Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold" Click="BtnResumeAuto_Click" Margin="3,8,3,2"/>
                </StackPanel>
            </GroupBox>

            <!-- 16 Gaze Poses Manual Tester -->
            <GroupBox Header="16 Arah Pandang (Manual Test)">
                <StackPanel>
                    <TextBlock Text="Baris 9: 0° s/d 157.5°" FontSize="11" Foreground="#A6ADC8" Margin="4,0,0,2"/>
                    <WrapPanel Orientation="Horizontal" ItemWidth="102">
                        <Button Content="0° (Atas)" Click="BtnGaze_Click" Tag="0"/>
                        <Button Content="22.5°" Click="BtnGaze_Click" Tag="1"/>
                        <Button Content="45° (Ka-Atas)" Click="BtnGaze_Click" Tag="2"/>
                        <Button Content="67.5°" Click="BtnGaze_Click" Tag="3"/>
                        <Button Content="90° (Kanan)" Click="BtnGaze_Click" Tag="4"/>
                        <Button Content="112.5°" Click="BtnGaze_Click" Tag="5"/>
                        <Button Content="135° (Ka-Bwh)" Click="BtnGaze_Click" Tag="6"/>
                        <Button Content="157.5°" Click="BtnGaze_Click" Tag="7"/>
                    </WrapPanel>

                    <TextBlock Text="Baris 10: 180° s/d 337.5°" FontSize="11" Foreground="#A6ADC8" Margin="4,6,0,2"/>
                    <WrapPanel Orientation="Horizontal" ItemWidth="102">
                        <Button Content="180° (Bawah)" Click="BtnGaze_Click" Tag="8"/>
                        <Button Content="202.5°" Click="BtnGaze_Click" Tag="9"/>
                        <Button Content="225° (Ki-Bwh)" Click="BtnGaze_Click" Tag="10"/>
                        <Button Content="247.5°" Click="BtnGaze_Click" Tag="11"/>
                        <Button Content="270° (Kiri)" Click="BtnGaze_Click" Tag="12"/>
                        <Button Content="292.5°" Click="BtnGaze_Click" Tag="13"/>
                        <Button Content="315° (Ki-Atas)" Click="BtnGaze_Click" Tag="14"/>
                        <Button Content="337.5°" Click="BtnGaze_Click" Tag="15"/>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>

            <!-- Behavioral Settings -->
            <GroupBox Header="Opsi Perilaku &amp; Aksesibilitas">
                <StackPanel>
                    <CheckBox x:Name="ChkReducedMotion" Content="Reduced Motion (Nonaktifkan perpindahan jalan)" Click="ChkReducedMotion_Click"/>
                    <CheckBox x:Name="ChkAutoWander" Content="Auto Wander (Pet sesekali jalan-jalan otomatis)" Click="ChkAutoWander_Click"/>
                    <CheckBox x:Name="ChkGazeTracking" Content="Gaze Tracking (Arah pandang ikuti mouse saat netral)" Click="ChkGazeTracking_Click"/>
                    <CheckBox x:Name="ChkTypingDetection" Content="Deteksi Mengetik (Mengetik memicu Review)" Click="ChkTypingDetection_Click"/>
                    <CheckBox x:Name="ChkResourceMonitoring" Content="Resource Monitoring Aktif (CPU &amp; RAM Sampling)" Click="ChkResourceMonitoring_Click"/>
                    <CheckBox x:Name="ChkShowBadges" Content="Tampilkan Indikator Beban (Keringat / Badge)" Click="ChkShowBadges_Click"/>
                </StackPanel>
            </GroupBox>

            <!-- Distribusi & Sistem Windows (Tahap 5) -->
            <GroupBox Header="Distribusi, Multi-Monitor &amp; Sistem (Tahap 5)">
                <StackPanel>
                    <CheckBox x:Name="ChkStartWithWindows" Content="Mulai Otomatis bersama Windows (Auto-Start Run)" Click="ChkStartWithWindows_Click"/>
                    
                    <Border Background="#181825" CornerRadius="6" Padding="10,8" Margin="0,4,0,6">
                        <StackPanel>
                            <TextBlock x:Name="TxtDpiInfo" Text="Resolusi &amp; DPI: 100% (96 DPI) | Mode: PerMonitorV2" FontSize="11" Foreground="#89B4FA"/>
                            <TextBlock x:Name="TxtMonitorsInfo" Text="Monitor Aktif: 1 Layar Terdeteksi" FontSize="11" Foreground="#A6ADC8" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Button x:Name="BtnRecoverDisplays" Content="Uji Pemulihan Multi-Monitor" Click="BtnRecoverDisplays_Click"/>
                        <Button x:Name="BtnOpenDataFolder" Content="Buka Folder Data/Pengaturan" Click="BtnOpenDataFolder_Click"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Scale & Window Controls -->
            <GroupBox Header="Pengaturan Ukuran &amp; Kontrol">
                <StackPanel>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Skala: " VerticalAlignment="Center"/>
                        <Slider x:Name="SliderScale" Grid.Column="1" Minimum="0.5" Maximum="2.5" Value="1.0"
                                SmallChange="0.25" LargeChange="0.5" TickFrequency="0.25" IsSnapToTickEnabled="True"
                                ValueChanged="SliderScale_ValueChanged" Margin="8,0"/>
                        <TextBlock x:Name="TxtScaleValue" Grid.Column="2" Text="1.0x" VerticalAlignment="Center" FontWeight="Bold"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button x:Name="BtnPauseResume" Content="Pause" Width="90" Click="BtnPauseResume_Click"/>
                        <Button Content="Jalan ke Kanan" Width="100" Click="BtnMoveRight_Click"/>
                        <Button Content="Jalan ke Kiri" Width="100" Click="BtnMoveLeft_Click"/>
                        <Button Content="Reset Posisi" Width="90" Click="BtnResetPos_Click"/>
                    </StackPanel>
                    <Button Content="Tutup Aplikasi Desktop Pet" Margin="0,8,0,0" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold" Click="BtnExit_Click"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</Window>
