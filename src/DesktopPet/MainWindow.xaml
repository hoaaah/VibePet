<Window x:Class="DesktopPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopPet"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.ContextMenu>
        <ContextMenu x:Name="PetContextMenu">
            <MenuItem Header="Animasi" x:Name="MenuAnimations"/>
            <MenuItem Header="Arah Pandang" x:Name="MenuGaze"/>
            <MenuItem Header="Ukuran Pet" x:Name="MenuScale"/>
            <MenuItem Header="Opsi Perilaku" x:Name="MenuBehavior"/>
            <Separator/>
            <MenuItem Header="Panel Kontrol &amp; Tester..." Click="MenuOpenControl_Click"/>
            <MenuItem Header="Reset Posisi" Click="MenuResetPos_Click"/>
            <Separator/>
            <MenuItem Header="Keluar" Click="MenuExit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid x:Name="RootGrid" Background="Transparent" Cursor="SizeAll">
        <Image x:Name="PetImage"
               Width="192" Height="208"
               Stretch="Fill"
               RenderOptions.BitmapScalingMode="NearestNeighbor"
               MouseLeftButtonDown="PetImage_MouseLeftButtonDown"
               MouseLeftButtonUp="PetImage_MouseLeftButtonUp"/>

        <!-- High CPU Sweat Droplet Indicator (Efek Keringat) -->
        <Canvas x:Name="SweatCanvas" Width="192" Height="208" IsHitTestVisible="False" Visibility="Collapsed">
            <Path Canvas.Left="125" Canvas.Top="25"
                  Data="M 8 0 C 8 0 0 12 0 18 C 0 22.4 3.6 26 8 26 C 12.4 26 16 22.4 16 18 C 16 12 8 0 8 0 Z"
                  Fill="#89DCEB" Opacity="0.92" Stroke="#74C7EC" StrokeThickness="1">
                <Path.RenderTransform>
                    <RotateTransform Angle="25"/>
                </Path.RenderTransform>
            </Path>
        </Canvas>

        <!-- Resource High Load Badges Stack -->
        <StackPanel x:Name="BadgeContainer"
                    Orientation="Vertical"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,4,0,0"
                    IsHitTestVisible="False">
            <Border x:Name="CpuBadge"
                    Background="#E6181825"
                    BorderBrush="#F38BA8"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="6,2"
                    Margin="0,1"
                    Visibility="Collapsed">
                <TextBlock x:Name="TxtCpuBadge" Text="🔥 CPU 85%" FontSize="10" FontWeight="Bold" Foreground="#F38BA8"/>
            </Border>
            <Border x:Name="RamBadge"
                    Background="#E6181825"
                    BorderBrush="#FAB387"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="6,2"
                    Margin="0,1"
                    Visibility="Collapsed">
                <TextBlock x:Name="TxtRamBadge" Text="⚡ RAM 88%" FontSize="10" FontWeight="Bold" Foreground="#FAB387"/>
            </Border>
        </StackPanel>
    </Grid>
</Window>
